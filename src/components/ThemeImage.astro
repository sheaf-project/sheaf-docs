---
// Renders the light or dark variant of a screenshot to match the current
// site theme. Both variants ship; Starlight's sl-hidden utilities pick one.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	light: ImageMetadata;
	dark: ImageMetadata;
	alt: string;
}

const { light, dark, alt } = Astro.props;
---

<Image src={light} alt={alt} class="dark:sl-hidden" />
<Image src={dark} alt={alt} class="light:sl-hidden" />
